# ==============================================================================
# FUERZAFIT - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Copiá este archivo a .env y completá con tus credenciales reales
# ==============================================================================

# SUPABASE (Base de datos PostgreSQL + Auth)
# Obtenelas en tu proyecto de Supabase (Project Settings > API)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# GEMINI AI (Asistente de entrenamiento para instructores)
# AI Studio o Google AI Studio API Key para /api/gemini/instructor-suggest
GEMINI_API_KEY=""

# ENTORNO Y PUERTO (Para despliegue en Railway / Render / Contenedor)
NODE_ENV="development"
PORT="3000"

# APP_URL (URL pública del despliegue, ej. https://fuerzafit.up.railway.app)
APP_URL="http://localhost:3000"

# ==============================================================================
# BETA: SEPARACIÓN ADMIN / SOCIOS + MODO DEMO
# ==============================================================================
# VITE_APP_MODE: fija el rol de un deploy entero (opcional — por defecto se usan
# los 2 links con el mismo deploy: ?app=admin y ?app=socio).
#   full  = ambos roles (desarrollo)
#   admin = solo dueño/staff
#   socio = solo socios
VITE_APP_MODE="full"

# VITE_DEMO_MODE: atajos de demostración (login 1-click, OTP 123456, cambio de
# perfil rápido). En BETA con Supabase real DEBE ser "false".
# En desarrollo local (npm run dev) se activa solo si vale "true".
VITE_DEMO_MODE="false"

# ==============================================================================
# ZONA MAESTRA (SuperAdmin) — Página totalmente distinta y privada
# ==============================================================================
# VITE_MAESTRO_KEY: clave maestra adicional para /maestro (además de role=superadmin).
# Solo dueño del software y empleados autorizados. No se sube al repo.
# Ejemplo: FuerzaMaestro2026!
VITE_MAESTRO_KEY="FuerzaMaestro2026!"

# ==============================================================================
# CHAT IA GRATUITO (consultas socios/admin) — elige uno, el resto es fallback
# ==============================================================================
# GEMINI_API_KEY ya arriba. Opcional free tier:
# GROQ_API_KEY="gsk_..."  // https://console.groq.com (free: llama-3.1-8b-instant)
# HF_API_KEY="hf_..."     // https://huggingface.co/settings/tokens (free: Mistral-7B)
# Si no hay keys, el chat usa mock local 100% gratuito.

# ==============================================================================
# FASE 2: MERCADO PAGO REAL (Checkout Pro & Webhooks) - Futura activación
# ==============================================================================
# MERCADO_PAGO_ACCESS_TOKEN="APP_USR-..."
# MERCADO_PAGO_PUBLIC_KEY="APP_USR-..."
# MERCADO_PAGO_WEBHOOK_SECRET="whsec_..."


